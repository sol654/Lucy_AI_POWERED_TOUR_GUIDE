# Database
DATABASE_URL=postgresql://lucy_user:lucy_pass@localhost:5432/lucy_db

# Groq LLM API
GROQ_API_KEY=your_groq_api_key_from_console.groq.com
GROQ_MODEL=llama-3.3-70b-versatile

# Geoapify Maps
GEOAPIFY_API_KEY=your_geoapify_api_key_from_geoapify.com

# Firebase (from google-services.json)
FIREBASE_API_KEY=your_firebase_android_api_key
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_STORAGE_BUCKET=your_firebase_project_id.appspot.com
FIREBASE_APP_ID=your_mobilesdk_app_id
FIREBASE_PROJECT_NUMBER=your_project_number
BACKEND_BASE_URL=http://localhost:8000

# Auth
JWT_SECRET_KEY=change-this-to-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=1440
